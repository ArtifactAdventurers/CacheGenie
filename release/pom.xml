<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.gruff.hardstop</groupId>
        <artifactId>cachegenie</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>release</artifactId>

    <dependencies>
        <dependency>
            <groupId>dev.gruff.hardstop</groupId>
            <artifactId>cli</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>../target/cachegenie.jar</outputFile>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.gruff.hardstop.cachegenie.cli.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Copy the fat jar to a target machine after packaging:
                 mvn package -Pdeploy-jar -Ddeploy.target=pi:
             deploy.target is anything scp accepts (host:, user@host:/path, an
             ~/.ssh/config alias, ...). Override the default below or pass -D. -->
        <profile>
            <id>deploy-jar</id>
            <properties>
                <deploy.target>asylum.local:~/cachegenie</deploy.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>scp-fat-jar</id>
                                <!-- Same phase as shade; within a phase plugins run in
                                     POM order, and this profile plugin is appended after
                                     the shade plugin, so the jar exists by now. -->
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>scp</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../target/cachegenie.jar</argument>
                                        <argument>${deploy.target}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
